# Scribed
DATABASE_URL=sqlite:///./scribed.db
STORAGE_DIR=storage
SCRIBED_API_TOKEN=replace-with-a-long-random-secret
ENVIRONMENT=development
PORT=9005

# Cloudflare R2 production storage (leave R2_BUCKET empty for local storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://your-public-r2-domain.example

# Docker Compose image tag (use a sequential integer, never latest)
SCRIBED_VERSION=1

# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://scribed:change-me@localhost:5432/scribed

# Resend (required only for document sending)
RESEND_API_KEY=
RESEND_FROM_EMAIL=scribed@vela.mikesplore.tech

# Telegram bot (required only to run bot.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
SCRIBED_API_URL=https://scribed.mikesplore.me

# Gatekeeper integration
GATEKEEPER_BASE_URL=https://gateapi.mikesplore.me
GATEKEEPER_EMAIL=mikepremium8@gmail.com
GATEKEEPER_PASSWORD=
GATEKEEPER_TOKEN=
GATEKEEPER_TIMEOUT=15
# Used by Gatekeeperd when notifying Scribed about a suspension
SCRIBED_CALLBACK_URL=http://localhost:9005
SCRIBED_INTEGRATION_SECRET=
