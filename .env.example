# Telegram bot (required only to run bot.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
SCRIBED_API_URL=http://localhost:8000

# Gatekeeper integration
GATEKEEPER_BASE_URL=https://gateapi.mikesplore.me
GATEKEEPER_EMAIL=mikepremium8@gmail.com
